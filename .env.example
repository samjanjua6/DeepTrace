# =============================================================================
# DeepTrace — Environment Variables Template
# Copy this to .env and fill in your values.
# NEVER commit the real .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_USER=deeptrace
POSTGRES_PASSWORD=deeptrace_dev_secret
POSTGRES_DB=deeptrace_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Prisma connection URL (used by `prisma db push`, `prisma generate`, and app)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# -----------------------------------------------------------------------------
# Redis / Celery
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=deeptrace_redis_secret
REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0"

# Celery uses a separate DB index to avoid key collisions with cache
CELERY_BROKER_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/1"
CELERY_RESULT_BACKEND="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/2"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=change_me_to_a_long_random_secret_at_least_32_chars
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG          # DEBUG | INFO | WARNING | ERROR

# CORS — comma-separated allowed origins
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"

# -----------------------------------------------------------------------------
# Object Storage (S3 / MinIO)
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000    # Set to "" for real AWS S3
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_DOCUMENTS=deeptrace-documents
S3_BUCKET_ARTIFACTS=deeptrace-artifacts
S3_REGION=ap-south-1

# -----------------------------------------------------------------------------
# LLM Providers (Multi-Agent Swarm)
# -----------------------------------------------------------------------------
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# -----------------------------------------------------------------------------
# API Key Configuration
# -----------------------------------------------------------------------------
# Prefix added to all generated API keys (format: dt_pk_<random>)
API_KEY_PREFIX=dt_pk_

# JWT for user sessions
JWT_SECRET_KEY=change_me_to_another_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
